# 실제 값을 채운 뒤 이 파일을 .env 로 복사해서 사용하세요. .env 는 절대 커밋하지 마세요.

# 수집을 실행할 플랫폼 목록 (쉼표 구분). 예: coupang,naver
PLATFORMS=coupang,naver

# 각 플랫폼 로그인 페이지 주소 (최초 수동 로그인 시 사용)
COUPANG_LOGIN_URL=https://wing.coupang.com/login
NAVER_LOGIN_URL=https://sell.smartstore.naver.com/login

# 브라우저를 화면에 띄울지 여부. 최초 로그인(login:coupang / login:naver)은 항상 headed 로 동작합니다.
HEADLESS=true

# 결과 JSON 저장 위치
OUTPUT_DIR=./data

# 주기 실행 스케줄 (node-cron 표현식). 기본값: 매일 오전 9시
SCHEDULE_CRON=0 9 * * *

# 크론 표현식 타임존
TZ=Asia/Seoul
