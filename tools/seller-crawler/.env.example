# 실제 값을 채운 뒤 이 파일을 .env 로 복사해서 사용하세요. .env 는 절대 커밋하지 마세요.

# 수집을 실행할 플랫폼 목록 (쉼표 구분). 예: coupang,naver
PLATFORMS=coupang,naver

# 네이버 스마트스토어센터 로그인 페이지 주소 (최초 수동 로그인 시 사용, 공식 API가 없어 브라우저 세션 방식 사용)
NAVER_LOGIN_URL=https://sell.smartstore.naver.com/login

# 브라우저를 화면에 띄울지 여부. 최초 로그인(login:naver)은 항상 headed 로 동작합니다.
HEADLESS=true

# ---- 쿠팡 Open API (WING > 오픈 API 관리 에서 발급) ----
# https://developers.coupang.com/ko/api 참고
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=

# 지급내역조회(settlement-histories)를 조회할 매출인식월 목록 (쉼표 구분, YYYY-MM).
# 비워두면 이번 달(UTC 기준)만 조회합니다.
COUPANG_SETTLEMENT_MONTHS=

# 결과 JSON 저장 위치
OUTPUT_DIR=./data

# 주기 실행 스케줄 (node-cron 표현식). 기본값: 매일 오전 9시
SCHEDULE_CRON=0 9 * * *

# 크론 표현식 타임존
TZ=Asia/Seoul
